CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_rockchip_rk3576-custom-router=y

# 核心网络工具与协议
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y

# USB 3.0 / USB 2.0 驱动
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-rockchip=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# PCIe 支持
CONFIG_PACKAGE_kmod-pci-core=y

# 以太网 PHY 驱动 (RTL8211F 等)
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-mdio-devres=y

# SKI.WB800D80S.1 / AIC8800D80: native LEDE SDIO WiFi + SDIO HCI
CONFIG_PACKAGE_kmod-aic8800-sdio=y
CONFIG_PACKAGE_aic8800-sdio-firmware=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y

# Bluetooth is registered by aic8800_fdrv (CONFIG_SDIO_BT=y), not UART/BCM
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_bluez-daemon=y
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-utils-extra=y
CONFIG_PACKAGE_bluez-utils-btmon=y

# Hardware / network / process diagnostics, built into the image (=y)
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_kmod-i2c-core=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_gpiod-tools=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_block-mount=y

# LuCI 界面与常用插件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-ttyd=y
